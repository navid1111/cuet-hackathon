# Environment Configuration Template
# Copy this file to .env for local development
# Replace placeholder values with your actual configuration

# ⚠️ SECURITY WARNING:
# - Never commit files with real credentials to git!
# - .env, .env.development, .env.production should be in .gitignore
# - Only .env.example should be committed (with placeholder values)

# Application
NODE_ENV=development
PORT=3000

# S3/MinIO Configuration
# For self-hosted S3 (MinIO/RustFS), configure these:
S3_REGION=us-east-1
S3_ENDPOINT=http://minio:9000
S3_ACCESS_KEY_ID=your_s3_access_key_here
S3_SECRET_ACCESS_KEY=your_s3_secret_key_here
S3_BUCKET_NAME=downloads
S3_FORCE_PATH_STYLE=true

# Redis Configuration
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=your_strong_redis_password_here

# Download Delay Simulation (for long-running download demo)
DOWNLOAD_DELAY_ENABLED=true
DOWNLOAD_DELAY_MIN_MS=10000
DOWNLOAD_DELAY_MAX_MS=200000

# Request Timeout
REQUEST_TIMEOUT_MS=30000

# Rate Limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100

# CORS (comma-separated origins or * for all)
CORS_ORIGINS=*

# Observability (optional)
SENTRY_DSN=
OTEL_EXPORTER_OTLP_ENDPOINT=http://jaeger:4318

# Feature Flags
ENABLE_STORAGE=true

